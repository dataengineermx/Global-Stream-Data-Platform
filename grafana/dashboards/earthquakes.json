                        "rawSql": "SELECT event_time AS time, latitude, longitude, magnitude, place, estado, municipio FROM analytics.fct_earthquakes WHERE $__timeFilter(event_time) AND magnitude >= $min_mag AND ('$ambito' = 'all' OR ('$ambito' = 'near' AND estado IS NOT NULL) OR ('$ambito' = 'land' AND in_mexico_land)) ORDER BY magnitude DESC LIMIT 5000"
