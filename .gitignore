# =============================================================================
# Secretos y configuración local (NUNCA versionar)
# =============================================================================
.env
.env.*
!.env.example

# Herramientas locales de Claude Code / MCP (pueden contener cadenas de conexión)
.mcp.json
.claude/settings.local.json

# =============================================================================
# Airflow: archivos generados en ejecución
# =============================================================================
# Se conserva la carpeta con .gitkeep para que el bind mount no la cree Docker como root
logs/*
!logs/.gitkeep
# airflow.cfg lo genera Airflow y puede incluir valores aleatorios (claves)
config/airflow.cfg
airflow.db
airflow-webserver.pid
standalone_admin_password.txt

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# =============================================================================
# Datos y respaldos (los datos viven en la base, no en el repositorio)
# =============================================================================
data/
*.dump
*.backup
*.sql.gz
*.bkp

# =============================================================================
# Editores y sistema operativo
# =============================================================================
.vscode/
.idea/
.DS_Store
*.swp
